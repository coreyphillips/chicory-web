# Set WALLET_HOST to the canonical hostname, e.g. wallet.example.org.
{$WALLET_HOST} {
	@relay path /peer /electrum
	handle @relay {
		reverse_proxy 127.0.0.1:8790 {
			header_up X-Chicory-Client-IP {http.request.remote.host}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Chicory-Client-IP {http.request.remote.host}
		}
	}
}
