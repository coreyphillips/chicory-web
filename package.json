    "@coreyphillips/paykit-discovery": "git+https://github.com/coreyphillips/paykit-discovery.git#d939fbf4a6d61fb3955b596da21926d545641262",
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0",
    "@number0/iroh": "1.1.0",
    "@scure/bip39": "2.4.0",
    "@synonymdev/pubky": "0.17.1",
    "@tanstack/react-query": "5.105.0",
    "@vercel/functions": "3.11.3",
    "bech32": "2.0.0",
    "class-variance-authority": "0.7.1",
    "jsqr": "1.4.0",
    "lucide-react": "1.65.0",
    "motion": "14.8.0",
    "next": "16.4.6",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0",
    "zod": "4.6.7",
    "zustand": "5.0.16",
    "clsx": "2.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
