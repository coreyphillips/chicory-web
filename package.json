{
  "name": "chicory-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "predev": "npm run wallet:build",
    "build": "next build --webpack",
    "prebuild": "npm run wallet:build",
    "start": "next start",
    "relay": "node --env-file=.env.local scripts/wallet/relay.mjs",
    "wallet:build": "node scripts/build-wallet.mjs",
    "postinstall": "patch-package --error-on-fail",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/wallet/*.test.mjs && vitest run",
    "test:wallet:browser": "npm run wallet:build && node scripts/wallet/worker-smoke.mjs"
  },
  "dependencies": {
    "@beignet/portable-engine": "file:vendor/beignet-portable-engine-0.43.6.tgz",
